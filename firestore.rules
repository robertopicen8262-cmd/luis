rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isVerifiedUser() && request.auth.uid == ownerId;
    }

    function isValidMachine(data) {
      return data.keys().hasAll([
          'code', 'name', 'area', 'status', 'temperature',
          'pressure', 'vibration', 'maintenancePending',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'name', 'area', 'status', 'temperature',
          'pressure', 'vibration', 'maintenancePending',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 30 && data.code.matches('^[A-Z0-9-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.area is string && data.area.size() >= 2 && data.area.size() <= 60
        && data.status in ['operando', 'detenido', 'mantenimiento']
        && (data.temperature is int || data.temperature is float) && data.temperature >= -50 && data.temperature <= 500
        && (data.pressure is int || data.pressure is float) && data.pressure >= 0 && data.pressure <= 10000
        && (data.vibration is int || data.vibration is float) && data.vibration >= 0 && data.vibration <= 200
        && data.maintenancePending is bool
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
          'folio', 'machineId', 'machineCode', 'machineName',
          'operator', 'date', 'shift', 'status',
          'temperature', 'pressure', 'vibration',
          'completedTaskIds', 'totalTasks', 'observations',
          'signature', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'folio', 'machineId', 'machineCode', 'machineName',
          'operator', 'date', 'shift', 'status',
          'temperature', 'pressure', 'vibration',
          'completedTaskIds', 'totalTasks', 'observations',
          'signature', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.folio is string && data.folio.size() >= 4 && data.folio.size() <= 40 && data.folio.matches('^TPM-[A-Z0-9-]+$')
        && isValidId(data.machineId)
        && data.machineCode is string && data.machineCode.size() >= 2 && data.machineCode.size() <= 30 && data.machineCode.matches('^[A-Z0-9-]+$')
        && data.machineName is string && data.machineName.size() >= 2 && data.machineName.size() <= 80
        && data.operator is string && data.operator.size() >= 2 && data.operator.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shift in ['matutino', 'vespertino', 'nocturno']
        && data.status in ['operando', 'detenido', 'mantenimiento']
        && (data.temperature is int || data.temperature is float) && data.temperature >= -50 && data.temperature <= 500
        && (data.pressure is int || data.pressure is float) && data.pressure >= 0 && data.pressure <= 10000
        && (data.vibration is int || data.vibration is float) && data.vibration >= 0 && data.vibration <= 200
        && data.completedTaskIds is list
        && data.completedTaskIds.size() <= 5
        && data.completedTaskIds.hasOnly(['oil', 'air_filter', 'lubrication', 'pressure_check', 'visual_inspection'])
        && (data.totalTasks is int || data.totalTasks is float) && data.totalTasks == 5
        && data.observations is string && data.observations.size() <= 1000
        && data.signature is string && data.signature.size() >= 2 && data.signature.size() <= 80
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection check document (get-only, authenticated)
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, write: if false;
    }

    // Machinery collection
    match /machines/{machineId} {
      allow get: if isSignedIn() && isValidId(machineId) && isOwner(existing().ownerId);
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(machineId)
        && isValidMachine(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(machineId)
        && isValidMachine(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'name', 'area', 'status', 'temperature',
          'pressure', 'vibration', 'maintenancePending', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(machineId)
        && isOwner(existing().ownerId);
    }

    // Maintenance reports collection
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && isOwner(existing().ownerId);
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/machines/$(incoming().machineId))
        && get(/databases/$(database)/documents/machines/$(incoming().machineId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().folio == existing().folio
        && incoming().machineId == existing().machineId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'operator', 'date', 'shift', 'status',
          'temperature', 'pressure', 'vibration',
          'completedTaskIds', 'observations', 'signature', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(reportId)
        && isOwner(existing().ownerId);
    }
  }
}
