{
  "entities": {
    "Machine": {
      "title": "Machine",
      "description": "Industrial equipment registered in TPM SmartAssist with operational status and inspection parameters.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique equipment identification code (e.g., PRENSA-01).",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[A-Z0-9-]+$"
        },
        "name": {
          "type": "string",
          "description": "Descriptive machine name.",
          "minLength": 2,
          "maxLength": 80
        },
        "area": {
          "type": "string",
          "description": "Plant area or production line.",
          "minLength": 2,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "description": "Current operational state.",
          "enum": ["operando", "detenido", "mantenimiento"]
        },
        "temperature": {
          "type": "number",
          "description": "Last recorded temperature in degrees Celsius."
        },
        "pressure": {
          "type": "number",
          "description": "Last recorded pressure in PSI."
        },
        "vibration": {
          "type": "number",
          "description": "Last recorded vibration in mm/s."
        },
        "maintenancePending": {
          "type": "boolean",
          "description": "Whether preventive autonomous maintenance is pending."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated workspace owner.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "code",
        "name",
        "area",
        "status",
        "temperature",
        "pressure",
        "vibration",
        "maintenancePending",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "MaintenanceReport": {
      "title": "MaintenanceReport",
      "description": "Autonomous TPM maintenance log entry recorded by a machine operator.",
      "type": "object",
      "properties": {
        "folio": {
          "type": "string",
          "description": "Unique report folio identifier.",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^TPM-[A-Z0-9-]+$"
        },
        "machineId": {
          "type": "string",
          "description": "Document ID of the associated machine.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "machineCode": {
          "type": "string",
          "description": "Unique equipment code at the time of inspection.",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[A-Z0-9-]+$"
        },
        "machineName": {
          "type": "string",
          "description": "Machine name at the time of inspection.",
          "minLength": 2,
          "maxLength": 80
        },
        "operator": {
          "type": "string",
          "description": "Name of the operator performing the inspection.",
          "minLength": 2,
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "description": "Inspection date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "shift": {
          "type": "string",
          "description": "Production shift.",
          "enum": ["matutino", "vespertino", "nocturno"]
        },
        "status": {
          "type": "string",
          "description": "Observed machine operational status.",
          "enum": ["operando", "detenido", "mantenimiento"]
        },
        "temperature": {
          "type": "number",
          "description": "Recorded temperature in degrees Celsius."
        },
        "pressure": {
          "type": "number",
          "description": "Recorded pressure in PSI."
        },
        "vibration": {
          "type": "number",
          "description": "Recorded vibration in mm/s."
        },
        "completedTaskIds": {
          "type": "array",
          "description": "List of completed preventive maintenance task identifiers."
        },
        "totalTasks": {
          "type": "number",
          "description": "Total preventive maintenance tasks evaluated."
        },
        "observations": {
          "type": "string",
          "description": "Operator notes, anomalies, or failures.",
          "maxLength": 1000
        },
        "signature": {
          "type": "string",
          "description": "Operator signature or responsible person name.",
          "minLength": 2,
          "maxLength": 80
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated workspace owner.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "folio",
        "machineId",
        "machineCode",
        "machineName",
        "operator",
        "date",
        "shift",
        "status",
        "temperature",
        "pressure",
        "vibration",
        "completedTaskIds",
        "totalTasks",
        "observations",
        "signature",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/machines/{machineId}": {
      "schema": {
        "$ref": "#/entities/Machine"
      },
      "description": "Industrial machinery catalog owned by the authenticated user."
    },
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/MaintenanceReport"
      },
      "description": "Autonomous TPM maintenance reports linked to a registered machine."
    }
  }
}
